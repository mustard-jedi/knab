{
  "name": "knab",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted envelope budgeting with custom cutoff periods",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "knab": "bin/knab.js",
    "knab-mcp": "bin/knab-mcp.js"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
