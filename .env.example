# Copy to .env and adjust. Every setting is optional.

# Port the server listens on.
PORT=3000

# 127.0.0.1 = only reachable through a reverse proxy on the same machine (recommended).
# 0.0.0.0   = reachable directly from other devices on the network.
HOST=127.0.0.1

# Where the SQLite database lives (relative to the project folder, or absolute).
DB_PATH=data/knab.sqlite

# Set both to true once the app is served over HTTPS behind nginx or Caddy.
# COOKIE_SECURE makes the login cookie HTTPS-only; TRUST_PROXY lets login rate
# limiting see the visitor's real IP address.
COOKIE_SECURE=false
TRUST_PROXY=false
